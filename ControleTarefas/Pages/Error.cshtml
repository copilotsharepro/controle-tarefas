@page
@model ErrorModel
@{
    ViewData["Title"] = "Erro";
}

<h1 class="text-danger">Erro.</h1>
<h2 class="text-danger">Ocorreu uma falha ao processar sua solicitação.</h2>

@if (Model.ShowRequestId)
{
    <p>
        <strong>Identificador da solicitação:</strong> <code>@Model.RequestId</code>
    </p>
}
