@page "{id:int}"
@model ControleTarefas.Pages.ExcluirModel
@{
    ViewData["Title"] = "Excluir tarefa";
}

<h1 class="h3 mb-3">Excluir tarefa</h1>

<div class="card border-danger shadow-sm">
    <div class="card-body">
        <p class="mb-3">Confirma a exclusão desta tarefa?</p>

        <dl class="row mb-0">
            <dt class="col-sm-3">Título</dt>
            <dd class="col-sm-9">@Model.Tarefa.Titulo</dd>

            <dt class="col-sm-3">Descrição</dt>
            <dd class="col-sm-9">@(string.IsNullOrWhiteSpace(Model.Tarefa.Descricao) ? "-" : Model.Tarefa.Descricao)</dd>

            <dt class="col-sm-3">Data</dt>
            <dd class="col-sm-9">@Model.Tarefa.Data.ToString("dd/MM/yyyy")</dd>

            <dt class="col-sm-3">Status</dt>
            <dd class="col-sm-9">@Model.Tarefa.Status</dd>
        </dl>

        <form method="post" class="d-flex flex-wrap gap-2 mt-3">
            <button type="submit" class="btn btn-danger">Excluir</button>
            <a asp-page="/Quadro" class="btn btn-outline-secondary">Cancelar</a>
        </form>
    </div>
</div>

